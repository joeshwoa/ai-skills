{
  "id": "lead-to-sheet",
  "name": "Lead webhook → Google Sheets",
  "nodes": [
    {
      "id": "80e629e8-3ed6-44de-86b9-802d5bb18fc1",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "32c48280-76b0-4036-8d2c-006707914721"
    },
    {
      "id": "1f2108f2-79f4-41f8-9011-36662315ffd9",
      "name": "Clean lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "n",
              "name": "name",
              "value": "={{ ($json.body.name || \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "e",
              "name": "email",
              "value": "={{ ($json.body.email || \"\").trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "p",
              "name": "phone",
              "value": "={{ ($json.body.phone || \"\").replace(/[^0-9+]/g, \"\") }}",
              "type": "string"
            },
            {
              "id": "s",
              "name": "source",
              "value": "={{ $json.body.source || \"website\" }}",
              "type": "string"
            },
            {
              "id": "t",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b4566fec-ea01-41fb-878f-5baab52dabd3",
      "name": "Valid email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.email }}",
              "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c4ce7cde-eaca-4907-b4fa-87ec59e1e469",
      "name": "Add to Leads sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        700,
        300
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Leads"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "phone": "={{ $json.phone }}",
            "source": "={{ $json.source }}",
            "received_at": "={{ $json.received_at }}"
          },
          "schema": [
            {
              "id": "name",
              "displayName": "name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "email",
              "displayName": "email",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "phone",
              "displayName": "phone",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "source",
              "displayName": "source",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "received_at",
              "displayName": "received_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "83c6629e-6ba3-4767-8231-6cec4c290e6a",
      "name": "Reply 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, email: $(\"Clean lead\").item.json.email } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "e48bd807-070b-44eb-9a04-d7388aaf6186",
      "name": "Reply 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        700,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: \"invalid email\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Lead webhook": {
      "main": [
        [
          {
            "node": "Clean lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean lead": {
      "main": [
        [
          {
            "node": "Valid email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid email?": {
      "main": [
        [
          {
            "node": "Add to Leads sheet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add to Leads sheet": {
      "main": [
        [
          {
            "node": "Reply 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}