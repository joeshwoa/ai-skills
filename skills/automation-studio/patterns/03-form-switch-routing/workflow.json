{
  "id": "form-switch-routing",
  "name": "Contact form → route by type",
  "nodes": [
    {
      "id": "4992fb46-a1d2-4ef1-b641-b359423c29f8",
      "name": "Contact form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        100,
        300
      ],
      "parameters": {
        "formTitle": "Contact us",
        "formDescription": "We reply within one working day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Type",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Sales"
                  },
                  {
                    "option": "Support"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "contact-us",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks — we got your message."
            }
          }
        }
      },
      "webhookId": "a62c7a3b-6eff-4309-9f38-e0d93168d09b"
    },
    {
      "id": "4c77ce20-fd45-4293-b8da-bb01bf47e5e7",
      "name": "Tidy fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "name",
              "value": "={{ $json.Name.trim() }}",
              "type": "string"
            },
            {
              "id": "b",
              "name": "email",
              "value": "={{ $json.Email.trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "c",
              "name": "type",
              "value": "={{ $json.Type.toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "d",
              "name": "message",
              "value": "={{ $json.Message.trim() }}",
              "type": "string"
            },
            {
              "id": "e",
              "name": "submitted_at",
              "value": "={{ $json.submittedAt || $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3844f358-5a32-4d68-b695-2356b1a1969e",
      "name": "Route by type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "sales",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "sales",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "support",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "support",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "other"
        }
      }
    },
    {
      "id": "f428d792-2c6d-4e0a-8c08-83419cba2cfa",
      "name": "Tell sales on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        700,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#sales"
        },
        "text": "=New sales lead from {{ $json.name }} <{{ $json.email }}>:\n> {{ $json.message }}",
        "otherOptions": {}
      },
      "webhookId": "106825b0-1a06-42ef-ae01-c2aead358f79"
    },
    {
      "id": "8864b71e-6c8c-4939-9154-2e42e84b7b17",
      "name": "Open support email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        700,
        450
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "support@example.com",
        "subject": "=[Support] {{ $json.name }}",
        "emailType": "text",
        "message": "=From: {{ $json.name }} <{{ $json.email }}>\n\n{{ $json.message }}",
        "options": {
          "replyTo": "={{ $json.email }}",
          "appendAttribution": false
        }
      },
      "webhookId": "d9da04fc-3735-4350-b4a7-002bc879e846"
    },
    {
      "id": "dfc00811-039c-4017-a31c-7b5d798e12c0",
      "name": "Mark for triage",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        700,
        600
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "t",
              "name": "status",
              "value": "needs-triage",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Contact form": {
      "main": [
        [
          {
            "node": "Tidy fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tidy fields": {
      "main": [
        [
          {
            "node": "Route by type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by type": {
      "main": [
        [
          {
            "node": "Tell sales on Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Open support email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark for triage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}