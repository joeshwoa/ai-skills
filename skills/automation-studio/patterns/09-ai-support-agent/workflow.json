{
  "id": "ai-support-agent",
  "name": "AI support agent (webhook)",
  "nodes": [
    {
      "id": "c26bff0e-1d35-471b-b2bb-b2fb92ee7152",
      "name": "Chat message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "support-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "3b316eeb-45e4-4eb5-9ab0-1341cbf59b7d"
    },
    {
      "id": "4e36dee5-71a7-4ef2-9c4f-ae7136334260",
      "name": "Valid message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        300,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a",
              "leftValue": "={{ ($json.body.message || \"\").trim().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "b",
              "leftValue": "={{ ($json.body.message || \"\").length }}",
              "rightValue": 2000,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "id": "c",
              "leftValue": "={{ $json.body.session_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "167665f8-a56d-4574-8105-8545d43928c0",
      "name": "Support agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        450
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are the support assistant of \"Cominde Store\". Reply in the customer's language (Egyptian Arabic if they write Arabic), short and friendly.\nFacts you may use: the lookup_order tool, and this policy — returns within 14 days, delivery 2–5 working days in Egypt, support hours 9:00–18:00 Cairo.\nNever invent order data. If you cannot help, or the customer is angry or asks for a human, end your reply with [HANDOFF].",
          "maxIterations": 6
        }
      }
    },
    {
      "id": "004eb031-01a0-4393-a5ac-c3521633f214",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        100,
        450
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {}
    },
    {
      "id": "1172e72a-06cf-42ba-bd49-94fb13e37f84",
      "name": "Conversation memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        100,
        600
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Chat message').item.json.body.session_id }}",
        "contextWindowLength": 12
      }
    },
    {
      "id": "283f511d-f1bb-4dc0-b434-dbe4266d94b8",
      "name": "lookup_order",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        100,
        750
      ],
      "parameters": {
        "description": "Look up an order by its number (e.g. \"A1023\"). Returns status, ETA and items. Call this whenever the customer mentions an order.",
        "language": "javaScript",
        "jsCode": "// Replace this demo table with an HTTP call or a database query.\nconst db = { A1023: { status: 'shipped', eta: '2026-10-10', items: [\"Headphones\"] }, A1024: { status: 'processing', eta: '2026-10-14', items: [\"Keyboard\"] } };\nconst id = String(query || '').toUpperCase().match(/[A-Z]\\d{3,}/)?.[0];\nreturn JSON.stringify(id && db[id] ? { order: id, ...db[id] } : { error: 'order not found', asked: query });"
      }
    },
    {
      "id": "207adcf3-49a9-404b-92b4-5475911fcb93",
      "name": "Shape reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        500,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "r",
              "name": "reply",
              "value": "={{ $json.output.replace(\"[HANDOFF]\", \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "h",
              "name": "handoff",
              "value": "={{ $json.output.includes(\"[HANDOFF]\") }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3284d5f3-6a17-4a3d-8f0e-e0da5df479f4",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        700,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.reply, handoff: $json.handoff } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "522e3ce5-0805-4457-a478-df695a76885d",
      "name": "Reply 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        500,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: \"message (1-2000 chars) and session_id are required\" } }}",
        "options": {
          "responseCode": 422
        }
      }
    }
  ],
  "connections": {
    "Chat message": {
      "main": [
        [
          {
            "node": "Valid message?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid message?": {
      "main": [
        [
          {
            "node": "Support agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply 422",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Support agent": {
      "main": [
        [
          {
            "node": "Shape reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI model": {
      "ai_languageModel": [
        [
          {
            "node": "Support agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Conversation memory": {
      "ai_memory": [
        [
          {
            "node": "Support agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "lookup_order": {
      "ai_tool": [
        [
          {
            "node": "Support agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Shape reply": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}