{
 "cases": [
  {
   "name": "real PDF text is extracted; correct invoice is saved",
   "trigger": {
    "body": {
     "file_url": "https://example.com/inv42.pdf"
    }
   },
   "mocks": {
    "Download PDF": [
     {
      "json": {},
      "binary": {
       "data": {
        "data": "",
        "mimeType": "application/pdf",
        "fileName": "invoice.pdf",
        "fileExtension": "pdf"
       }
      }
     }
    ],
    "Extract invoice fields": [
     {
      "output": {
       "invoice_no": "INV-2026-0042",
       "date": "2026-10-01",
       "supplier": "Nile Office Supplies",
       "subtotal": 2350,
       "vat": 329,
       "total": 2679,
       "currency": "EGP",
       "lines": [
        {
         "item": "Paper A4",
         "qty": 10,
         "amount": 450
        },
        {
         "item": "Toner HP 85A",
         "qty": 2,
         "amount": 1900
        }
       ]
      }
     }
    ],
    "Append to Invoices": [
     {
      "ok": true
     }
    ]
   },
   "expect": {
    "nodes": {
     "PDF to text": {
      "contains": "INV-2026-0042"
     },
     "Check the maths": {
      "json": {
       "valid": true,
       "total": 2679
      }
     },
     "Reply saved": {
      "json": {
       "status": 200,
       "response": {
        "ok": true,
        "invoice_no": "INV-2026-0042",
        "total": 2679
       }
      }
     },
     "Reply needs review": {
      "ran": false
     }
    }
   }
  },
  {
   "name": "AI misread total → caught by code, not saved",
   "trigger": {
    "body": {
     "file_url": "https://example.com/inv42.pdf"
    }
   },
   "mocks": {
    "Download PDF": [
     {
      "json": {},
      "binary": {
       "data": {
        "data": "",
        "mimeType": "application/pdf",
        "fileName": "invoice.pdf",
        "fileExtension": "pdf"
       }
      }
     }
    ],
    "Extract invoice fields": [
     {
      "output": {
       "invoice_no": "INV-2026-0042",
       "date": "2026-10-01",
       "supplier": "Nile Office Supplies",
       "subtotal": 2350,
       "vat": 329,
       "total": 2769,
       "currency": "EGP",
       "lines": [
        {
         "item": "Paper A4",
         "qty": 10,
         "amount": 450
        },
        {
         "item": "Toner HP 85A",
         "qty": 2,
         "amount": 1900
        }
       ]
      }
     }
    ]
   },
   "expect": {
    "nodes": {
     "Check the maths": {
      "json": {
       "valid": false
      },
      "contains": "≠ total 2769"
     },
     "Append to Invoices": {
      "ran": false
     },
     "Reply needs review": {
      "json": {
       "status": 422
      }
     }
    }
   }
  }
 ]
}