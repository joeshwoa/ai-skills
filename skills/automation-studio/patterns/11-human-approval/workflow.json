{
  "id": "human-approval",
  "name": "Expense approval with human in the loop",
  "nodes": [
    {
      "id": "8f8f0fcd-fe40-42f1-a2da-fdfdff36772b",
      "name": "Expense request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "expense",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "35daa2a6-d0a4-4247-8ce1-57d1eb8ec77f"
    },
    {
      "id": "4646c950-856e-4100-b130-d36ae2f95c54",
      "name": "Normalise",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "employee",
              "value": "={{ $json.body.employee }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "amount",
              "value": "={{ Number($json.body.amount) }}",
              "type": "number"
            },
            {
              "id": "3",
              "name": "reason",
              "value": "={{ ($json.body.reason || \"\").slice(0, 300) }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "request_id",
              "value": "={{ $execution.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "527c01a1-31e3-4833-aef2-7488ce4e66ee",
      "name": "Reply 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true, request_id: $json.request_id } }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "ab81caca-a0b9-4491-8ef6-8fabb91dafe6",
      "name": "Over 1000 EGP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a",
              "leftValue": "={{ $json.amount }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ac6e6f71-44e1-42a1-a118-03bdbb24eac7",
      "name": "Ask manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "sendTo": "manager@example.com",
        "subject": "=Approve {{ $json.amount }} EGP for {{ $json.employee }}?",
        "message": "={{ $json.employee }} requests {{ $json.amount }} EGP.\nReason: {{ $json.reason }}\nRequest #{{ $json.request_id }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Decline"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 3,
              "resumeUnit": "days"
            }
          }
        }
      },
      "webhookId": "7090ccc4-871a-4668-8964-fbaf268adc15"
    },
    {
      "id": "9a6663d6-1682-40b8-b769-2eff833227a2",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b",
              "leftValue": "={{ $json.data && $json.data.approved }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "efbbb882-fe35-472e-91b0-c165d061d237",
      "name": "Approved by manager",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "e",
              "name": "employee",
              "value": "={{ $(\"Normalise\").item.json.employee }}",
              "type": "string"
            },
            {
              "id": "a",
              "name": "amount",
              "value": "={{ $(\"Normalise\").item.json.amount }}",
              "type": "number"
            },
            {
              "id": "s",
              "name": "status",
              "value": "approved",
              "type": "string"
            },
            {
              "id": "b",
              "name": "decided_by",
              "value": "manager",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "76d792ed-b4ae-4934-a24d-8684c270eabf",
      "name": "Notify requester",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#expenses"
        },
        "text": "={{ $json.employee }}: {{ $json.amount }} EGP → *{{ $json.status }}* (by {{ $json.decided_by }})",
        "otherOptions": {}
      },
      "webhookId": "6bba4b96-2427-4160-8d12-058e28fe7182"
    },
    {
      "id": "f964ea94-0545-4bb1-9bfc-e38426f31354",
      "name": "Declined or timed out",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1300,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "e",
              "name": "employee",
              "value": "={{ $(\"Normalise\").item.json.employee }}",
              "type": "string"
            },
            {
              "id": "a",
              "name": "amount",
              "value": "={{ $(\"Normalise\").item.json.amount }}",
              "type": "number"
            },
            {
              "id": "s",
              "name": "status",
              "value": "declined",
              "type": "string"
            },
            {
              "id": "b",
              "name": "decided_by",
              "value": "manager",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "24c6b13b-e2c6-4e06-8c6a-1d5d2ac98f0d",
      "name": "Auto-approved",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        900,
        450
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "s",
              "name": "status",
              "value": "approved",
              "type": "string"
            },
            {
              "id": "b",
              "name": "decided_by",
              "value": "policy (≤ 1000)",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Expense request": {
      "main": [
        [
          {
            "node": "Normalise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalise": {
      "main": [
        [
          {
            "node": "Reply 202",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reply 202": {
      "main": [
        [
          {
            "node": "Over 1000 EGP?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Over 1000 EGP?": {
      "main": [
        [
          {
            "node": "Ask manager",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Auto-approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask manager": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Approved by manager",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Declined or timed out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved by manager": {
      "main": [
        [
          {
            "node": "Notify requester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Declined or timed out": {
      "main": [
        [
          {
            "node": "Notify requester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto-approved": {
      "main": [
        [
          {
            "node": "Notify requester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}