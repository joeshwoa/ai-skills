{
  "id": "orchestrator",
  "name": "Weekly customer scoring (orchestrator)",
  "nodes": [
    {
      "id": "559dd838-aac9-4c68-8ab8-c07bf9bce653",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "d3786450-2822-433c-bb89-eb2816ec6669",
      "name": "List customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://dummyjson.com/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "5"
            },
            {
              "name": "select",
              "value": "id,email"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b02b9568-8417-4dd9-a74e-bbe051c50173",
      "name": "One per customer",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "users",
        "options": {}
      }
    },
    {
      "id": "8d341693-d432-4b5f-9e7b-763effa3e4a1",
      "name": "Score customer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "each",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "name:Score customer (sub-workflow)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "customer_id": "={{ $json.id }}",
            "email": "={{ $json.email }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "customer_id",
              "displayName": "customer_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "number"
            },
            {
              "id": "email",
              "displayName": "email",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "33116f2c-ad97-447f-b7a6-39ed6ec3273e",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows = $input.all().map(i => i.json).filter(r => r.tier);\nconst by = t => rows.filter(r => r.tier === t).length;\nconst failed = $input.all().length - rows.length;\nconst top = [...rows].sort((a, b) => b.spent - a.spent).slice(0, 3).map(r => `${r.email} (${r.spent})`);\nreturn [{ json: { scored: rows.length, failed, gold: by('gold'), silver: by('silver'), bronze: by('bronze'), new: by('new'),\n  text: `Weekly customers: ${rows.length} scored${failed ? ', ' + failed + ' failed' : ''} — gold ${by('gold')}, silver ${by('silver')}, bronze ${by('bronze')}. Top: ${top.join(', ')}` } }];"
      }
    },
    {
      "id": "877bc98c-f941-4bdf-a205-08e1421c62a3",
      "name": "Post report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#sales"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "webhookId": "4754f0a6-478a-4f9d-a75a-2e020082f272"
    }
  ],
  "connections": {
    "Every Monday 08:00": {
      "main": [
        [
          {
            "node": "List customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List customers": {
      "main": [
        [
          {
            "node": "One per customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per customer": {
      "main": [
        [
          {
            "node": "Score customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score customer": {
      "main": [
        [
          {
            "node": "Build report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build report": {
      "main": [
        [
          {
            "node": "Post report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}