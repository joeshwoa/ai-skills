{
  "version": 1,
  "template": "ad_pas_master",
  "brand": null,
  "language": null,
  "color_mode": "editor_talent",
  "title": "{{TITLE}}",
  "about": "Performance ad (any length): Problem → Agitate → Solution → Proof → Offer/CTA, with cutdowns for each slot.",
  "meta": [
    [
      "Format",
      "{{talent / UGC / product demo}}"
    ],
    [
      "Master",
      "{{30 sec}} · cutdowns {{15 / 6 sec}}"
    ],
    [
      "Ratios",
      "{{9:16 · 4:5 · 16:9}}"
    ],
    [
      "Framework",
      "PAS"
    ]
  ],
  "brief": {
    "content_type": "ad",
    "brand_name": "{{brand name as said/shown}}",
    "platforms": [
      "{{youtube|instagram_reels|tiktok|facebook_reels|linkedin|website|tv}}"
    ],
    "audience": "{{who exactly — role, age band, place, what they know}}",
    "awareness_stage": "{{unaware|problem_aware|solution_aware|product_aware|most_aware}}",
    "goal": "{{awareness|consideration|leads|conversions|…}}",
    "funnel_stage": "{{top|middle|bottom}}",
    "format": "{{talent_plus_screens}}",
    "hook_type": "{{contrarian|pain|result_first}}",
    "duration_sec": 30,
    "cta": "{{one action}}",
    "scope": "{{…}}",
    "account_type": "{{creator|business}}",
    "trend_refs": [],
    "placements": [
      "{{meta_reels|meta_feed|tiktok_infeed|youtube_skippable|youtube_bumper|youtube_non_skippable|…}}"
    ],
    "ratios": [
      "{{9:16}}",
      "{{4:5}}",
      "{{16:9}}"
    ]
  },
  "scenes": [
    {
      "title": "SCENE 01 — HOOK",
      "duration_sec": 3,
      "blocks": [
        {
          "type": "visual",
          "lines": [
            "{{thumb-stopping first frame; logo bug or product visible}}"
          ]
        },
        {
          "type": "onscreen_text",
          "lines": [
            "{{≤7 words}}"
          ]
        },
        {
          "type": "dialogue",
          "speaker": "{{talent}}",
          "lines": [
            "{{hook ≤ 3 s}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 02 — PROBLEM + AGITATE",
      "duration_sec": 5,
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "{{talent}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 03 — SOLUTION",
      "duration_sec": 8,
      "blocks": [
        {
          "type": "broll",
          "lines": [
            "{{product/service in use}}"
          ]
        },
        {
          "type": "dialogue",
          "speaker": "{{talent}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 04 — PROOF",
      "duration_sec": 6,
      "blocks": [
        {
          "type": "onscreen_text",
          "lines": [
            "{{true, sourced proof point}}"
          ]
        },
        {
          "type": "dialogue",
          "speaker": "{{talent}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 05 — OFFER + CTA",
      "duration_sec": 4,
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "{{talent}}",
          "lines": [
            "{{CTA}}"
          ]
        },
        {
          "type": "super",
          "lines": [
            "{{offer terms / legal line if needed}}"
          ]
        }
      ]
    }
  ],
  "cutdowns": [
    {
      "name": "15s",
      "target_sec": 15,
      "scenes": [
        1,
        3,
        5
      ],
      "ratio": "{{9:16}}",
      "placement": "{{meta_reels}}"
    },
    {
      "name": "6s bumper",
      "target_sec": 6,
      "scenes": [
        1
      ],
      "end_frame_sec": 2,
      "ratio": "16:9",
      "placement": "youtube_bumper"
    }
  ],
  "end_frame": {
    "lines": [
      "{{product / offer}}",
      "{{CTA}}",
      "{{brand}}"
    ]
  },
  "editor_notes": [
    "{{captions in safe zone; logo from frame 1; export every ratio from one master}}"
  ],
  "posting": {
    "ad_copy": {
      "primary_text": "{{hook line + value + CTA, ≤125 chars visible}}",
      "headline": "{{≤40 chars}}",
      "description": "{{≤30 chars}}",
      "cta_button": "{{Learn More|Sign Up|Shop Now|…}}"
    },
    "alt_hooks": [
      "{{hook variant 1}}",
      "{{hook variant 2}}",
      "{{hook variant 3}}"
    ]
  }
}