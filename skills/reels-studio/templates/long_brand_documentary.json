{
  "version": 1,
  "template": "long_brand_documentary",
  "brand": null,
  "language": null,
  "color_mode": "editor_talent",
  "title": "{{TITLE}}",
  "about": "Brand film / mini-documentary (2–10 min): real people, interview bites + observational footage, a story arc, minimal narration.",
  "meta": [
    [
      "Format",
      "Brand documentary"
    ],
    [
      "Target Duration",
      "{{3–6 min}}"
    ],
    [
      "Location",
      "{{…}}"
    ]
  ],
  "brief": {
    "content_type": "long_form",
    "brand_name": "{{brand name as said/shown}}",
