          "speaker": "{{interviewee}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 03 — THE CHALLENGE",
      "chapter": "{{…}}",
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "{{interviewee}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 04 — THE TURN",
      "chapter": "{{…}}",
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "{{interviewee}}",
          "lines": [
            "{{…}}"
          ]
        }
      ]
    },
    {
      "title": "SCENE 05 — WHAT'S NEXT",
      "chapter": "{{…}}",
      "blocks": [
        {
          "type": "voiceover",
          "lines": [
